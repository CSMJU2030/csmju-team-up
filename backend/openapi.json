  "info": {
    "title": "CS TeamUp API",
    "description": "CSMJU2030 Project Collaborator Finder API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csmju_teamup_access_token"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "COURSE",
              "SENIOR_PROJECT",
              "PERSONAL_COMPETITION"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "TEACHER_ASSIGNED",
              "SELF_CREATED",
              "UNSPECIFIED"
            ],
            "default": "SELF_CREATED"
          },
          "scope": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "DEPARTMENT",
              "UNSPECIFIED"
            ],
            "default": "PERSONAL"
          },
          "compensationType": {
            "type": "string",
            "enum": [
              "NONE",
              "REWARD",
              "WAGE"
            ],
            "default": "NONE"
          },
          "compensationAmount": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Total project budget in THB"
          },
          "courseCode": {
            "type": "string",
            "maxLength": 50
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "duration": {
            "type": "string",
            "maxLength": 120
          },
          "format": {
            "type": "string",
            "enum": [
              "ONLINE",
              "ONSITE",
              "HYBRID"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contactText": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "title",
          "kind",
          "size",
          "format",
          "description",
          "roles",
          "skills"
        ]
      },
      "StatusDto": {
        "type": "object",
        "properties": {}
      },
      "ApplyProjectDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "maxLength": 120
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "InviteProjectDto": {
        "type": "object",
        "properties": {
          "inviteeCoreUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "inviteeCoreUserId"
        ]
      },
      "AskQuestionDto": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "question"
        ]
      },
      "AnswerQuestionDto": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "answer"
        ]
      },
      "ReviewDto": {
        "type": "object",
        "properties": {
          "toCoreUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "stars": {
