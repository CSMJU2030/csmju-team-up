  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csmju_teamup_access_token"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "ProjectId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ApplicationId": {
        "name": "applicationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "InvitationId": {
        "name": "invitationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "QuestionId": {
        "name": "questionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ConversationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "UUID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "requestBodies": {
      "Project": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProjectInput"
            }
          }
        }
      }
    },
    "schemas": {
      "ProjectKind": {
        "type": "string",
        "enum": [
          "COURSE",
          "SENIOR_PROJECT",
          "PERSONAL_COMPETITION"
        ]
      },
      "ProjectFormat": {
        "type": "string",
        "enum": [
          "ONLINE",
          "ONSITE",
          "HYBRID"
        ]
      },
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "RECRUITING",
          "IN_PROGRESS",
          "COMPLETED"
        ]
      },
      "ProjectInput": {
        "type": "object",
        "required": [
          "title",
          "kind",
          "size",
          "format",
          "description",
          "roles",
          "skills"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "$ref": "#/components/schemas/ProjectKind"
          },
          "courseCode": {
            "type": "string",
            "maxLength": 50
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "duration": {
            "type": "string",
            "maxLength": 120
          },
          "format": {
            "$ref": "#/components/schemas/ProjectFormat"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contactText": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "ApplicationInput": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "maxLength": 120
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "InvitationInput": {
        "type": "object",
        "required": [
          "inviteeCoreUserId"
        ],
        "properties": {
          "inviteeCoreUserId": {
            "type": "string",
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "ProfileInput": {
        "type": "object",
        "required": [
          "skills",
          "isAvailable"
        ],
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "githubUrl": {
            "type": "string",
            "format": "uri"
          },
          "linkedinUrl": {
            "type": "string",
            "format": "uri"
          },
          "contactText": {
            "type": "string",
            "maxLength": 500
          },
          "isAvailable": {
            "type": "boolean"
          }
        }
      },
      "PortfolioInput": {
        "type": "object",
        "required": [
          "imageId"
        ],
        "properties": {
          "imageId": {
            "type": "string",
            "maxLength": 128
          },
          "caption": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "ConversationInput": {
        "type": "object",
        "required": [
          "otherCoreUserId"
        ],
        "properties": {
          "otherCoreUserId": {
