{
  "name": "csmju-teamup",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint",
    "typecheck": "pnpm --filter backend typecheck && pnpm --filter frontend typecheck",
    "test": "pnpm --filter backend test",
    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:deploy": "pnpm --filter backend prisma:deploy",
    "openapi:generate": "pnpm --filter backend openapi:generate",
    "generate:api": "pnpm --filter backend openapi:generate",
    "db:seed": "pnpm --filter backend build:seed"
  }
}
